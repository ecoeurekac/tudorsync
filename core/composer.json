{
    "name": "tudorsync/core",
    "description": "Platform-agnostic sync logic for TUDOR's authorized-retailer e-commerce inventory API program.",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "phpoffice/phpspreadsheet": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Tudorsync\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tudorsync\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
