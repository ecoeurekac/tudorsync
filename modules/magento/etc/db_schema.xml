<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!--
        One row per order placed by a customer who landed from tudorwatch.com (UTM cookie set by
        view/frontend/templates/utm-capture.phtml). Data source for the "sold online through this
        programme" figures of TUDOR's monthly report. Kept out of sales_order on purpose: the
        go-live data reload replaces the sales tables, and a separate table survives it.
    -->
    <table name="tudorsync_order_attribution" resource="sales" engine="innodb"
           comment="TUDOR e-Stock programme: orders from customers referred by tudorwatch.com">
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="sales_order.entity_id"/>
        <column xsi:type="varchar" name="increment_id" length="50" nullable="true" comment="Order number"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="true" comment="Store"/>
        <column xsi:type="varchar" name="utm_source" length="100" nullable="false" comment="utm_source"/>
        <column xsi:type="varchar" name="utm_medium" length="100" nullable="true" comment="utm_medium"/>
        <column xsi:type="varchar" name="utm_campaign" length="100" nullable="true" comment="utm_campaign"/>
        <column xsi:type="datetime" name="landed_at" nullable="true" comment="Last landing from TUDOR (UTC)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Order placed at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="order_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TUDORSYNC_ORDER_ATTRIBUTION_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="tudorsync_order_attribution" column="order_id"
                    referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="TUDORSYNC_ORDER_ATTRIBUTION_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
    <!--
        TUDOR model codes whose stock or product data changed since they were last published
        (Model\Realtime\PendingQueue). One row per model code, re-queuing just refreshes it.
        Written by the stock/order/product hooks, emptied every minute by Cron\PublishPending
        and by every successful full sync. Losing it is harmless: the hourly full batch
        publishes everything anyway.
    -->
    <table name="tudorsync_pending_stock" resource="default" engine="innodb"
           comment="TUDOR e-Stock: model codes waiting to be republished">
        <column xsi:type="varchar" name="model_code" length="64" nullable="false" comment="TUDOR model code (mc)"/>
        <column xsi:type="varchar" name="reason" length="255" nullable="true" comment="Last change that queued it"/>
        <column xsi:type="timestamp" name="queued_at" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Last queued at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="model_code"/>
        </constraint>
    </table>
    <!--
        Figures of TUDOR's monthly report that this store can't count by itself, typed in the admin
        (Reports > TUDOR e-Stock > Monthly report): web analytics until core brings them from GA4,
        and the boutique figures, which TUDOR itself expects to be estimated by the staff. The
        online sales are never stored here: they are counted from the orders when the report is built.
    -->
    <table name="tudorsync_report_period" resource="default" engine="innodb"
           comment="TUDOR e-Stock monthly report: manually entered figures per month">
        <column xsi:type="varchar" name="period" length="7" nullable="false" comment="Month, YYYY-MM"/>
        <column xsi:type="int" name="sessions" unsigned="true" nullable="true" comment="Sessions from tudorwatch.com"/>
        <column xsi:type="int" name="unique_visitors" unsigned="true" nullable="true" comment="Unique visitors from tudorwatch.com"/>
        <column xsi:type="int" name="added_to_cart" unsigned="true" nullable="true" comment="People who added a TUDOR watch to the cart"/>
        <column xsi:type="int" name="boutique_sales" unsigned="true" nullable="true" comment="TUDOR watches sold in boutique through the programme"/>
        <column xsi:type="int" name="boutique_appointments" unsigned="true" nullable="true" comment="Boutique appointments through the programme"/>
        <column xsi:type="text" name="comments" nullable="true" comment="Comments column of the report"/>
        <column xsi:type="varchar" name="updated_by" length="100" nullable="true" comment="Admin user"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"
                comment="Last change"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="period"/>
        </constraint>
    </table>
    <!--
        Every Excel report generated from the admin, kept in the database (not in var/, which gets
        emptied) with the figures it was built from, so a report already sent to TUDOR can be
        downloaded again exactly as it was.
    -->
    <table name="tudorsync_report_file" resource="default" engine="innodb"
           comment="TUDOR e-Stock monthly report: generated Excel files">
        <column xsi:type="int" name="file_id" unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="varchar" name="period_from" length="7" nullable="false" comment="First month, YYYY-MM"/>
        <column xsi:type="varchar" name="period_to" length="7" nullable="false" comment="Last month, YYYY-MM"/>
        <column xsi:type="varchar" name="language" length="2" nullable="false" comment="Template language"/>
        <column xsi:type="boolean" name="is_draft" nullable="false" default="false" comment="Generated with mandatory figures missing"/>
        <column xsi:type="varchar" name="filename" length="255" nullable="false" comment="File name"/>
        <column xsi:type="mediumblob" name="content" nullable="false" comment="xlsx file"/>
        <column xsi:type="text" name="figures" nullable="true" comment="JSON: the rows written into the file"/>
        <column xsi:type="varchar" name="created_by" length="100" nullable="true" comment="Admin user"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Generated at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="file_id"/>
        </constraint>
        <index referenceId="TUDORSYNC_REPORT_FILE_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
