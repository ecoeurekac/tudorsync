<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="tudorsync_catalog_preview" xsi:type="object">Tudorsync\EcommerceSync\Console\Command\CatalogPreviewCommand</item>
                <item name="tudorsync_sync_run" xsi:type="object">Tudorsync\EcommerceSync\Console\Command\SyncRunCommand</item>
                <item name="tudorsync_connection_test" xsi:type="object">Tudorsync\EcommerceSync\Console\Command\TestConnectionCommand</item>
                <item name="tudorsync_model_code_fill" xsi:type="object">Tudorsync\EcommerceSync\Console\Command\ModelCodeFillCommand</item>
                <item name="tudorsync_realtime_publish" xsi:type="object">Tudorsync\EcommerceSync\Console\Command\RealtimePublishCommand</item>
                <item name="tudorsync_report_programme_sales" xsi:type="object">Tudorsync\EcommerceSync\Console\Command\ProgrammeSalesCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- Proxies: every bin/magento call builds the command list; don't load the catalog stack for it. -->
    <type name="Tudorsync\EcommerceSync\Console\Command\CatalogPreviewCommand">
        <arguments>
            <argument name="catalogConnector" xsi:type="object">Tudorsync\EcommerceSync\Model\CatalogConnector\Proxy</argument>
        </arguments>
    </type>
    <type name="Tudorsync\EcommerceSync\Console\Command\SyncRunCommand">
        <arguments>
            <argument name="syncRunner" xsi:type="object">Tudorsync\EcommerceSync\Model\SyncRunner\Proxy</argument>
        </arguments>
    </type>
    <type name="Tudorsync\EcommerceSync\Console\Command\TestConnectionCommand">
        <arguments>
            <argument name="syncRunner" xsi:type="object">Tudorsync\EcommerceSync\Model\SyncRunner\Proxy</argument>
        </arguments>
    </type>

    <type name="Tudorsync\EcommerceSync\Console\Command\ModelCodeFillCommand">
        <arguments>
            <argument name="productAction" xsi:type="object">Magento\Catalog\Model\Product\Action\Proxy</argument>
        </arguments>
    </type>

    <type name="Tudorsync\EcommerceSync\Console\Command\RealtimePublishCommand">
        <arguments>
            <argument name="syncRunner" xsi:type="object">Tudorsync\EcommerceSync\Model\SyncRunner\Proxy</argument>
        </arguments>
    </type>

    <!-- Real-time publishing: queue the TUDOR model code of whatever moved (Model\Realtime).
         MSI only; stores without MSI are covered by the stock item observer in etc/events.xml. -->
    <type name="Magento\InventoryReservationsApi\Model\AppendReservationsInterface">
        <plugin name="tudorsync_queue_on_reservations" type="Tudorsync\EcommerceSync\Plugin\QueueOnReservations"/>
    </type>
    <type name="Magento\InventoryApi\Api\SourceItemsSaveInterface">
        <plugin name="tudorsync_queue_on_source_items_save" type="Tudorsync\EcommerceSync\Plugin\QueueOnSourceItemsSave"/>
    </type>

    <type name="Tudorsync\EcommerceSync\Console\Command\ProgrammeSalesCommand">
        <arguments>
            <argument name="programmeSalesSource" xsi:type="object">Tudorsync\EcommerceSync\Model\Report\ProgrammeSalesSource\Proxy</argument>
        </arguments>
    </type>

    <!-- Click & collect in the monthly report: shipping methods that mean "picked up in store".
         Quera uses Amasty Store Pickup (amstorepick_amstorepick1, _2, ...). Empty list = the
         store can't tell, and the report leaves the field blank. -->
    <type name="Tudorsync\EcommerceSync\Model\Report\ProgrammeSalesSource">
        <arguments>
            <argument name="pickupShippingMethodPrefixes" xsi:type="array">
                <item name="amasty_store_pickup" xsi:type="string">amstorepick_</item>
            </argument>
        </arguments>
    </type>

    <!-- Own log file: var/log/tudorsync.log -->
    <virtualType name="Tudorsync\EcommerceSync\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/tudorsync.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="Tudorsync\EcommerceSync\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">tudorsync</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">Tudorsync\EcommerceSync\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Tudorsync\EcommerceSync\Model\SyncRunner">
        <arguments>
            <argument name="logger" xsi:type="object">Tudorsync\EcommerceSync\Logger</argument>
        </arguments>
    </type>
    <type name="Tudorsync\EcommerceSync\Model\Realtime\ChangeRecorder">
        <arguments>
            <argument name="logger" xsi:type="object">Tudorsync\EcommerceSync\Logger</argument>
        </arguments>
    </type>
    <type name="Tudorsync\EcommerceSync\Observer\SaveOrderAttribution">
        <arguments>
            <argument name="logger" xsi:type="object">Tudorsync\EcommerceSync\Logger</argument>
        </arguments>
    </type>
</config>
