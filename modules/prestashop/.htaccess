# Nothing in this module is meant to be opened directly from the web: the cron goes through
# PrestaShop's front controller (index.php?fc=module&module=tudorsync&controller=cron). Only the
# front-end assets in views/ are public (see views/.htaccess).

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
